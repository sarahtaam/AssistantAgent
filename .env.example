# Copy to .env and fill in. .env is gitignored — never commit real values.

# development (default) | production. Production refuses to start without
# Postgres, Redis, explicit CORS origins and a strong JWT secret.
APP_ENV=development

# ── Authentication (required) ─────────────────────────────────────────────
# The API verifies JWTs issued by your identity provider. HS256 shared
# secret, at least 32 characters. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Or verify RS256/ES256 tokens with the provider's public key instead:
# JWT_ALGORITHMS=RS256
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Optional: also require these claims to match.
JWT_ISSUER=
JWT_AUDIENCE=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated front-end origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Storage ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/novatel_agent.db
# Production: DATABASE_URL=postgresql+psycopg://user:password@host:5432/novatel
# Unset = in-memory sessions (single process). Required in production.
REDIS_URL=
# Only used by docker-compose.yml:
POSTGRES_PASSWORD=

# ── LLM ───────────────────────────────────────────────────────────────────
# Without a key the agent still runs end-to-end (see README) but falls
# back to a deterministic message wherever the LLM would normally respond.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Per-client limits on endpoints that can call the LLM.
LLM_RATE_LIMITS=20/minute;300/day
# Max seconds per LLM HTTP attempt, and in total across retries, before the
# agent gives up and answers with its deterministic fallback.
LLM_REQUEST_TIMEOUT_SECONDS=10
LLM_TOTAL_TIMEOUT_SECONDS=15

# ── Monitoring ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json (default in production) or text
LOG_FORMAT=text
# Set to enable GET /metrics for Prometheus (send as a bearer token).
METRICS_TOKEN=
# Optional error tracking (Sentry). No request bodies or user data are sent.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Branding ──────────────────────────────────────────────────────────────
SUPPORT_PHONE=1234
CURRENCY_SYMBOL=$

# ── Email (optional) ──────────────────────────────────────────────────────
# Left unset, notification emails are only logged (recipient masked)
# instead of being sent — which is what the demo does by default.
# Set SMTP_USER and SMTP_PASSWORD to switch to real sending.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
