# Copy to .env and fill in your own key to enable live LLM responses.
# Without it, the agent still runs end-to-end (see README) but falls
# back to a deterministic message wherever the LLM would normally respond.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

COMPANY_NAME=NovaTel
SUPPORT_PHONE=1234
CURRENCY_SYMBOL=$

DATABASE_URL=sqlite:///./data/novatel_agent.db

# Optional. Left unset, notification emails are printed to the console
# instead of being sent — which is what the demo does by default.
# Set SMTP_USER and SMTP_PASSWORD to switch to real sending.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
